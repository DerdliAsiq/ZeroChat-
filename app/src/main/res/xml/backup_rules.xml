<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Nothing is backed up: decrypted messages, identity keys and vault
     settings must never leave the device (backups are encrypted with a password instead). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
