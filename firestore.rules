rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 32 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
             data.bio is string && data.bio.size() <= 240 &&
             data.publicKey is string && data.publicKey.size() >= 8 && data.publicKey.size() <= 2048 &&
             data.safetyFingerprint is string && data.safetyFingerprint.size() >= 8 && data.safetyFingerprint.size() <= 256 &&
             data.onlineStatus is string && data.onlineStatus.size() >= 1 && data.onlineStatus.size() <= 32;
    }

    function isValidChatRoom(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 10 &&
             data.participantUids[0] is string &&
             data.participantNames is string && data.participantNames.size() >= 1 && data.participantNames.size() <= 512 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.isGroup is bool &&
             data.roomKeyHint is string && data.roomKeyHint.size() >= 4 && data.roomKeyHint.size() <= 256 &&
             data.lastCipherPreview is string && data.lastCipherPreview.size() <= 1024 &&
             data.lastSenderName is string && data.lastSenderName.size() <= 64 &&
             data.defaultTtlSeconds is int && data.defaultTtlSeconds >= 0 && data.defaultTtlSeconds <= 604800;
    }

    function isValidEncryptedEnvelope(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderUsername is string && data.senderUsername.size() >= 1 && data.senderUsername.size() <= 64 &&
             data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 10 &&
             data.participantUids[0] is string &&
             data.ciphertext is string && data.ciphertext.size() >= 1 && data.ciphertext.size() <= 262144 &&
             data.iv is string && data.iv.size() >= 4 && data.iv.size() <= 128 &&
             data.signatureHash is string && data.signatureHash.size() >= 4 && data.signatureHash.size() <= 256 &&
             data.messageType is string && data.messageType in ['TEXT', 'IMAGE', 'VOICE', 'POLL', 'LOCATION', 'FILE'] &&
             data.encryptedMeta is string && data.encryptedMeta.size() <= 262144 &&
             data.reactionsSummary is string && data.reactionsSummary.size() <= 2048 &&
             data.ttlSeconds is int && data.ttlSeconds >= 0 && data.ttlSeconds <= 604800;
    }

    function isValidEncryptedStatus(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 64 &&
             data.ciphertext is string && data.ciphertext.size() >= 1 && data.ciphertext.size() <= 4096 &&
             data.iv is string && data.iv.size() >= 4 && data.iv.size() <= 128 &&
             data.themeColorHex is string && data.themeColorHex.size() >= 4 && data.themeColorHex.size() <= 16 &&
             data.viewCount is int && data.viewCount >= 0 && data.viewCount <= 1000000;
    }

    function isValidCallSignal(data) {
      return data.callerId is string && data.callerId.size() >= 1 && data.callerId.size() <= 128 &&
             data.callerUsername is string && data.callerUsername.size() >= 1 && data.callerUsername.size() <= 64 &&
             data.calleeUsername is string && data.calleeUsername.size() >= 1 && data.calleeUsername.size() <= 64 &&
             data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 10 &&
             data.participantUids[0] is string &&
             data.callType is string && data.callType in ['AUDIO', 'VIDEO'] &&
             data.status is string && data.status in ['RINGING', 'CONNECTED', 'ENDED'] &&
             data.safetyEmojis is string && data.safetyEmojis.size() >= 1 && data.safetyEmojis.size() <= 64;
    }

    // 1. /users/{userId} - Public Cryptographic Key & Username Directory (Zero PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().username is string;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'bio', 'publicKey', 'safetyFingerprint', 'onlineStatus', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'bio', 'publicKey', 'safetyFingerprint', 'onlineStatus', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'bio', 'publicKey', 'safetyFingerprint', 'onlineStatus', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. /rooms/{roomId} - E2EE Chat Rooms
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasAll(['ownerId', 'participantUids', 'participantNames', 'title', 'isGroup', 'roomKeyHint', 'lastCipherPreview', 'lastSenderName', 'defaultTtlSeconds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'participantUids', 'participantNames', 'title', 'isGroup', 'roomKeyHint', 'lastCipherPreview', 'lastSenderName', 'defaultTtlSeconds', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidChatRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidChatRoom(incoming()) &&
                       request.auth.uid in existing().participantUids &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['participantUids', 'participantNames', 'title', 'roomKeyHint', 'lastCipherPreview', 'lastSenderName', 'defaultTtlSeconds', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(roomId) && existing().ownerId == request.auth.uid;
    }

    // 3. /envelopes/{envelopeId} - E2EE Message Envelopes
    match /envelopes/{envelopeId} {
      allow get: if isSignedIn() && isValidId(envelopeId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isSignedIn() &&
                       isValidId(envelopeId) &&
                       incoming().senderId == request.auth.uid &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasAll(['roomId', 'senderId', 'senderUsername', 'participantUids', 'ciphertext', 'iv', 'signatureHash', 'messageType', 'encryptedMeta', 'reactionsSummary', 'ttlSeconds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['roomId', 'senderId', 'senderUsername', 'participantUids', 'ciphertext', 'iv', 'signatureHash', 'messageType', 'encryptedMeta', 'reactionsSummary', 'ttlSeconds', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidEncryptedEnvelope(incoming());

      allow update: if isSignedIn() &&
                       isValidId(envelopeId) &&
                       isValidEncryptedEnvelope(incoming()) &&
                       request.auth.uid in existing().participantUids &&
                       incoming().roomId == existing().roomId &&
                       incoming().senderId == existing().senderId &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['ciphertext', 'iv', 'signatureHash', 'encryptedMeta', 'reactionsSummary', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(envelopeId) && request.auth.uid in existing().participantUids;
    }

    // 4. /statuses/{statusId} - 24h Encrypted Statuses
    match /statuses/{statusId} {
      allow get: if isSignedIn() && isValidId(statusId);
      allow list: if isSignedIn() && existing().userId is string;

      allow create: if isSignedIn() &&
                       isValidId(statusId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'authorUsername', 'ciphertext', 'iv', 'themeColorHex', 'viewCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorUsername', 'ciphertext', 'iv', 'themeColorHex', 'viewCount', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidEncryptedStatus(incoming());

      allow update: if isSignedIn() &&
                       isValidId(statusId) &&
                       isValidEncryptedStatus(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['viewCount', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(statusId) && existing().userId == request.auth.uid;
    }

    // 5. /calls/{callId} - Encrypted P2P Call Signaling
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && request.auth.uid in existing().participantUids;
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       incoming().callerId == request.auth.uid &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasAll(['callerId', 'callerUsername', 'calleeUsername', 'participantUids', 'callType', 'status', 'safetyEmojis', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['callerId', 'callerUsername', 'calleeUsername', 'participantUids', 'callType', 'status', 'safetyEmojis', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidCallSignal(incoming());

      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       isValidCallSignal(incoming()) &&
                       request.auth.uid in existing().participantUids &&
                       incoming().callerId == existing().callerId &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(callId) && request.auth.uid in existing().participantUids;
    }
  }
}
