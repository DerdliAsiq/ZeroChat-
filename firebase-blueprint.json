{
  "entities": {
    "UserProfile": {
      "type": "object",
      "description": "Public profile and V2 identity keys. users/{uid}.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth uid."
        },
        "username": {
          "type": "string",
          "description": "Unique handle, claimed in usernames/{handle}."
        },
        "displayName": {
          "type": "string",
          "description": "Display name (max 64)."
        },
        "bio": {
          "type": "string",
          "description": "Short bio (max 200)."
        },
        "publicKey": {
          "type": "string",
          "description": "X.509 base64 P-256 ECDH public key used to wrap room keys."
        },
        "signingKey": {
          "type": "string",
          "description": "X.509 base64 P-256 ECDSA public key used to verify message signatures."
        },
        "safetyFingerprint": {
          "type": "string",
          "description": "60-digit fingerprint of both public keys."
        },
        "onlineStatus": {
          "type": "string",
          "description": "ONLINE or OFFLINE."
        },
        "protocolVersion": {
          "type": "integer",
          "description": "2 once V2 keys are published."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "username",
        "displayName",
        "bio",
        "publicKey",
        "signingKey",
        "safetyFingerprint",
        "onlineStatus",
        "protocolVersion",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameClaim": {
      "type": "object",
      "description": "usernames/{handle}: one owner per handle.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner uid."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "uid",
        "createdAt"
      ]
    },
    "ChatRoom": {
      "type": "object",
      "description": "rooms/{roomId}. Direct rooms use id dm_{uidA}_{uidB} (sorted) and start as PENDING requests.",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Creator uid."
        },
        "participantUids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Members (max 16)."
        },
        "participantNames": {
          "type": "string",
          "description": "Comma-separated handles, display only."
        },
        "title": {
          "type": "string",
          "description": "Group title or @peer."
        },
        "isGroup": {
          "type": "boolean",
          "description": "Group or direct conversation."
        },
        "status": {
          "type": "string",
          "description": "ACTIVE, PENDING (request) or REJECTED."
        },
        "requesterUid": {
          "type": "string",
          "description": "Who sent the direct-message request."
        },
        "keyVersion": {
          "type": "integer",
          "description": "Current room key version (rooms/{id}/keys/{version})."
        },
        "defaultTtlSeconds": {
          "type": "integer",
          "description": "Default self-destruct time, 0 = off."
        },
        "lastPreviewKv": {
          "type": "integer",
          "description": "Key version of the encrypted preview."
        },
        "lastPreviewIv": {
          "type": "string",
          "description": "AES-GCM IV of the preview."
        },
        "lastPreviewCt": {
          "type": "string",
          "description": "Encrypted last-message preview."
        },
        "lastSenderUid": {
          "type": "string",
          "description": "Sender of the last message."
        },
        "lastActivityAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "ownerId",
        "participantUids",
        "participantNames",
        "title",
        "isGroup",
        "status",
        "requesterUid",
        "keyVersion",
        "defaultTtlSeconds",
        "lastPreviewKv",
        "lastPreviewIv",
        "lastPreviewCt",
        "lastSenderUid",
        "lastActivityAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomKeyVersion": {
      "type": "object",
      "description": "rooms/{roomId}/keys/{version}: random 256-bit room key wrapped per participant (ECIES: ephemeral P-256 ECDH + HKDF-SHA256 + AES-256-GCM).",
      "properties": {
        "createdBy": {
          "type": "string",
          "description": "uid that generated the key."
        },
        "wrappedKeys": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "uid -> wrapped key (ephemeralPub.iv.ciphertext)."
        },
        "recipientKeyIds": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "uid -> identity key id the key was wrapped for."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "createdBy",
        "wrappedKeys",
        "recipientKeyIds",
        "createdAt"
      ]
    },
    "EncryptedEnvelope": {
      "type": "object",
      "description": "envelopes/{envelopeId}: one message. The whole payload (text, media, metadata) is AES-256-GCM encrypted with the room key, bound to roomId/envelopeId/senderId/keyVersion as AAD, and ECDSA-signed by the sender.",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Room."
        },
        "senderId": {
          "type": "string",
          "description": "Sender uid (must be the writer)."
        },
        "participantUids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Copy of the room members at send time (must equal the room's)."
        },
        "v": {
          "type": "integer",
          "description": "Protocol version, 2."
        },
        "keyVersion": {
          "type": "integer",
          "description": "Room key version used."
        },
        "iv": {
          "type": "string",
          "description": "AES-GCM IV."
        },
        "ciphertext": {
          "type": "string",
          "description": "Encrypted JSON payload."
        },
        "sig": {
          "type": "string",
          "description": "ECDSA signature."
        },
        "signerKeyId": {
          "type": "string",
          "description": "Identity key id of the signer."
        },
        "ttlSeconds": {
          "type": "integer",
          "description": "Self-destruct time, 0 = off."
        },
        "expireAt": {
          "type": "string",
          "description": "Expiry time; Firestore TTL policy deletes the document after it."
        },
        "edited": {
          "type": "boolean",
          "description": "Re-encrypted by the sender."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "roomId",
        "senderId",
        "participantUids",
        "v",
        "keyVersion",
        "iv",
        "ciphertext",
        "sig",
        "ttlSeconds",
        "edited",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomAnnotation": {
      "type": "object",
      "description": "rooms/{roomId}/annotations/{envelopeId}_{uid}_{kind}: one user's encrypted reaction, poll vote or pin.",
      "properties": {
        "envelopeId": {
          "type": "string",
          "description": "Message."
        },
        "uid": {
          "type": "string",
          "description": "Author."
        },
        "kind": {
          "type": "string",
          "description": "REACTION, VOTE or PIN."
        },
        "keyVersion": {
          "type": "integer",
          "description": "Room key version."
        },
        "iv": {
          "type": "string",
          "description": "AES-GCM IV."
        },
        "ciphertext": {
          "type": "string",
          "description": "Encrypted value."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "envelopeId",
        "uid",
        "kind",
        "keyVersion",
        "iv",
        "ciphertext",
        "updatedAt"
      ]
    },
    "RoomPresence": {
      "type": "object",
      "description": "rooms/{roomId}/presence/{uid}: read position and typing indicator.",
      "properties": {
        "lastReadAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "typingAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "lastReadAt",
        "typingAt"
      ]
    },
    "EncryptedStatus": {
      "type": "object",
      "description": "statuses/{statusId}: 24 h story encrypted with a random key wrapped for each audience member.",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Author."
        },
        "audienceUids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Who may read it (includes the author)."
        },
        "wrappedKeys": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "uid -> wrapped status key."
        },
        "iv": {
          "type": "string",
          "description": "AES-GCM IV."
        },
        "ciphertext": {
          "type": "string",
          "description": "Encrypted text."
        },
        "sig": {
          "type": "string",
          "description": "ECDSA signature."
        },
        "themeColorHex": {
          "type": "string",
          "description": "Background colour."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "expireAt": {
          "type": "string",
          "description": "Expiry (TTL policy)."
        }
      },
      "required": [
        "userId",
        "audienceUids",
        "wrappedKeys",
        "iv",
        "ciphertext",
        "sig",
        "themeColorHex",
        "createdAt",
        "expireAt"
      ]
    },
    "CallSignal": {
      "type": "object",
      "description": "calls/{callId}: call signalling. Media goes to calls/{callId}/media/{uid}, AES-GCM encrypted with a key derived from the room key.",
      "properties": {
        "callerId": {
          "type": "string",
          "description": "Caller."
        },
        "calleeUid": {
          "type": "string",
          "description": "Callee."
        },
        "roomId": {
          "type": "string",
          "description": "Direct room."
        },
        "keyVersion": {
          "type": "integer",
          "description": "Room key version for the call key."
        },
        "participantUids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "[caller, callee]."
        },
        "callType": {
          "type": "string",
          "description": "AUDIO or VIDEO."
        },
        "status": {
          "type": "string",
          "description": "RINGING -> CONNECTED -> ENDED."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "callerId",
        "calleeUid",
        "roomId",
        "keyVersion",
        "participantUids",
        "callType",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CallMediaChunk": {
      "type": "object",
      "description": "calls/{callId}/media/{uid}: latest encrypted audio/video chunk from one side.",
      "properties": {
        "seq": {
          "type": "integer",
          "description": "Per-sender sequence number."
        },
        "iv": {
          "type": "string",
          "description": "AES-GCM IV."
        },
        "ciphertext": {
          "type": "string",
          "description": "Encrypted {a: audio, v: video} JSON."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "seq",
        "iv",
        "ciphertext",
        "updatedAt"
      ]
    }
  }
}